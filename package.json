{
  "name": "@williamanjo/ally-6-microsoft",
  "description": "Microsoft OAuth2 (Azure AD / Entra ID) authentication driver for AdonisJS v7 and Ally v6",
  "version": "1.5.0",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": "./build/index.js"
  },
  "files": [
