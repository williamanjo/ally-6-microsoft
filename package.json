    "test": "tsx bin/test.ts",
    "build": "tsc"
  },
  "devDependencies": {
    "@adonisjs/ally": "^6.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/eslint-config": "^3.0.0",
